rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getCouple(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function isMemberOfCouple(coupleId) {
      let couple = getCouple(coupleId);
      return isSignedIn() && (couple.partner1 == request.auth.uid || couple.partner2 == request.auth.uid);
    }

    // User Profile
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               (data.email == null || data.email is string) && (data.email.size() <= 256 || data.email == null);
      }

      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
    }

    // Invites Collection
    match /invites/{inviteId} {
      // Anyone can query an invite by token or 4-digit code to validate it
      allow read: if true;
      // Created by workspace members
      allow create: if isSignedIn();
      // Updated when accepted, cancelled or expired
      allow update: if isSignedIn();
    }

    // Couple/Space Document
    match /couples/{coupleId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Transactions
    match /couples/{coupleId}/transactions/{transactionId} {
      allow list, get: if isMemberOfCouple(coupleId);
      allow create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Accounts
    match /couples/{coupleId}/accounts/{accountId} {
      allow list, get, create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Clients
    match /couples/{coupleId}/clients/{clientId} {
      allow list, get, create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Credit Cards
    match /couples/{coupleId}/creditCards/{cardId} {
      allow list, get, create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Investments
    match /couples/{coupleId}/investments/{investmentId} {
      allow list, get, create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Traffic Campaigns
    match /couples/{coupleId}/traffic/{trafficId} {
      allow list, get, create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Commitments
    match /couples/{coupleId}/commitments/{commitmentId} {
      allow list, get, create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Debts
    match /couples/{coupleId}/debts/{debtId} {
      allow list, get, create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Goals
    match /couples/{coupleId}/goals/{goalId} {
      allow list, get, create, update, delete: if isMemberOfCouple(coupleId);
    }

    // Logs
    match /couples/{coupleId}/logs/{logId} {
      allow list, get, create: if isMemberOfCouple(coupleId);
      allow update, delete: if false;
    }
  }
}
